{
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1, 0.2, 0.8],
        "alpha": 1.0
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2, 0.5, 1.0],
        "alpha": 1.0
      }
    }
  }
}
