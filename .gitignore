!Cargo.lock
!rust-toolchain.toml
!rustfmt.toml
!clippy.toml
!justfile

# Source code
!crates/
!crates/**
!/examples/
!/scripts/

# Godot
**/.godot/
**/.themosis/
**/*.gdextension.uid
